# ─────────────────────────────────────────────────────────────
# MONOLITH Digital Shadow Service — Environment Configuration
# ─────────────────────────────────────────────────────────────

# Server
PORT=3100
NODE_ENV=development
LOG_LEVEL=debug

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=monolith-dev-token
INFLUXDB_ORG=daph-decor
INFLUXDB_BUCKET=digital-shadow

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=monolith-digital-shadow-01
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CA_PATH=
MQTT_CERT_PATH=
MQTT_KEY_PATH=

# Redis (Event Bus)
REDIS_URL=redis://localhost:6379

# OPC UA
OPCUA_APPLICATION_NAME=MONOLITH Digital Shadow
OPCUA_APPLICATION_URI=urn:monolith:digital-shadow:opcua-client
OPCUA_SECURITY_MODE=SignAndEncrypt
OPCUA_SECURITY_POLICY=Basic256Sha256
OPCUA_CERTIFICATE_PATH=./certs/opcua-client.pem
OPCUA_PRIVATE_KEY_PATH=./certs/opcua-client-key.pem

# Machine Endpoints (comma-separated for multiple)
BIESSE_OPCUA_ENDPOINT=opc.tcp://192.168.1.10:4840
HOMAG_OPCUA_ENDPOINT=opc.tcp://192.168.1.20:4840
HOMAG_CONNECT_API_URL=https://connect.homag.cloud/api/v1
HOMAG_CONNECT_API_KEY=
KDT_MODBUS_HOST=192.168.1.30
KDT_MODBUS_PORT=502

# CAS Bridge (MONOLITH Factory Server)
FACTORY_SERVER_URL=http://localhost:3000
FACTORY_SERVER_API_KEY=

# Ed25519 Signing
ED25519_PRIVATE_KEY_PATH=./certs/sensor-signing-key.pem
ED25519_PUBLIC_KEY_PATH=./certs/sensor-signing-key.pub
