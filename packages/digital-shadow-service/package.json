{
  "name": "@monolith/digital-shadow-service",
  "version": "0.1.0",
  "description": "MONOLITH Manufacturing OS — Digital Shadow Service (Phase 1: OPC UA + MQTT Ingestion)",
  "author": "DAPH Decor Engineering",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/adapters tests/services",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "test:load": "k6 run tests/load/k6-command-load.js",
    "test:load:smoke": "k6 run tests/load/k6-smoke.js",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@influxdata/influxdb-client": "^1.35.0",
    "@noble/ed25519": "^2.1.0",
    "cron": "^3.1.7",
    "dotenv": "^16.4.5",
    "fft-js": "^0.0.12",
    "hono": "^4.6.0",
    "ioredis": "^5.4.1",
    "modbus-serial": "^8.0.17",
    "mqtt": "^5.15.2",
    "node-opcua": "^2.128.0",
    "node-opcua-client": "^2.128.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.3.0",
    "simple-statistics": "^7.10.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "5.0",
    "eslint": "^9.12.0",
    "nock": "^14.0.17",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
