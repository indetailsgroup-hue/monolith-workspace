# =============================================================================
# .env.example — Monolith Manufacturing OS / FPR Field-Purchase sub-system
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Supabase project
# ─────────────────────────────────────────────────────────────────────────────

# PostgREST base URL (used by integration tests and the dashboard)
SUPABASE_URL=http://localhost:54321

# Service-role JWT key (bypasses RLS; used by workers and seed scripts)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon key (used by the dashboard client for unauthenticated endpoints)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# HS256 JWT signing secret (used by integration tests to mint test JWTs)
# Must be at least 32 characters long.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars

# Raw PostgreSQL connection string (used by apply_migrations.sh)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Supabase project ref (used by supabase CLI for function deployment)
SUPABASE_PROJECT_REF=your-project-ref

# Supabase access token (for `supabase functions deploy` in CI)
SUPABASE_ACCESS_TOKEN=sbp_your-access-token

# ─────────────────────────────────────────────────────────────────────────────
# LINE Messaging API — FPR channel
# ─────────────────────────────────────────────────────────────────────────────

# Channel secret used to verify incoming LINE webhook signatures (HMAC-SHA256)
# Required by: line_webhook_handler.ts
LINE_FPR_CHANNEL_SECRET=your-line-fpr-channel-secret

# Channel access token for outbound LINE API calls (replies and pushes)
# Required by: line_webhook_handler.ts
LINE_FPR_CHANNEL_ACCESS_TOKEN=your-line-fpr-channel-access-token

# Channel access token for the LINE OA dispatch worker
# Required by: line_oa_dispatch_worker.ts
# (May be the same as LINE_FPR_CHANNEL_ACCESS_TOKEN if using one OA account)
LINE_CHANNEL_ACCESS_TOKEN=your-line-oa-channel-access-token

# Optional: override the LINE API base URL (default: https://api.line.me)
# Useful for local mock servers in integration tests
LINE_API_BASE=https://api.line.me

# ─────────────────────────────────────────────────────────────────────────────
# Dispatch worker configuration
# ─────────────────────────────────────────────────────────────────────────────

# Maximum number of pending outbound messages to process in one drain call
# Default: 50
DISPATCH_LIMIT=50

# Vertical identifier used to scope outbound messages to the FPR module
# Default: field_purchase
VERTICAL=field_purchase

# Bearer token that non-service-role callers must present to invoke the worker
# Required if you invoke the worker from application code rather than with the
# service-role key directly. Optional — leave empty to require service-role only.
WORKER_INVOKE_KEY=

# Supabase Edge Function invoke key (for function-to-function invocations)
FUNCTION_INVOKE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# LINE webhook rate limiting (Phase 10 hardening)
# ─────────────────────────────────────────────────────────────────────────────

# Maximum LINE events per userId per minute before a 429 is returned
# Default: 30
RATE_LIMIT_PER_MIN=30
