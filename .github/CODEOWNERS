# ──────────────────────────────────────────────────────────────────
# SECURITY-CRITICAL: Pinned Keysets — Dual Approval Required
# PR-S4.3: Key Rotation Ceremony + Dual Approval (2-Man Rule)
# Both @security-custodian-a AND @security-custodian-b must approve.
# Self-approval is not allowed (enforced by branch protection).
# See: security/key-ceremonies/CEREMONY_SPEC.md
# ──────────────────────────────────────────────────────────────────

# Production keysets — dual custodian approval
/tools/iimos-verify/keys/*.json                    @security-custodian-a @security-custodian-b

# Development keysets
/tools/iimos-verify/keys/dev.*.json                @security-custodian-a

# Key lifecycle scripts
/tools/iimos-verify/scripts/update_keyset.ts       @security-custodian-a @security-custodian-b
/tools/iimos-verify/scripts/retire_key.ts          @security-custodian-a @security-custodian-b
/tools/iimos-verify/scripts/fetch_kms_pubkey*.ts   @security-custodian-a @security-custodian-b
/tools/iimos-verify/scripts/validate_keyset.ts     @security-custodian-a @security-custodian-b

# Key type definitions
/tools/iimos-verify/src/keys/                      @security-custodian-a @security-custodian-b

# Key rotation ceremony documentation and evidence
/security/key-ceremonies/                          @security-custodian-a @security-custodian-b

# Keyset validation workflows
/.github/workflows/keyset-validate.yml             @security-custodian-a @security-custodian-b
/.github/workflows/keyset-dual-approval.yml        @security-custodian-a @security-custodian-b

# Release and crypto signing code
/src/release/                                      @security-custodian-a
/src/crypto/                                       @security-custodian-a

