+    when p_state = '42501' and p_msg like 'permission denied for schema%' then 'schema_denied: ' || p_msg
+    when p_state = '42883' then 'undefined_function: ' || left(p_msg, 100)
+    else format('body reached: %s %s', p_state, left(p_msg, 100))
+  end
